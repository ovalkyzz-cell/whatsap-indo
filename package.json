{
  "name": "whatsap-indo",
  "version": "1.0.0",
  "description": "Whatsap Indo - clone WhatsApp real-time chat dengan autentikasi email, kirim pesan, foto, video, file hingga 2GB, dan pusat notifikasi",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "admin": "node admin/server.js",
    "test": "node test/crop.js && node test/calls.js && node test/antispam.js && node test/callflow.js && node test/e2e.js",
    "test:crop": "node test/crop.js",
    "test:calls": "node test/calls.js",
    "test:antispam": "node test/antispam.js",
    "test:callflow": "node test/callflow.js",
    "test:bots": "node test/bot-reply.js",
    "test:storage-save": "node test/storage-save.js",
    "test:storage-manage": "node test/storage-manage.js",
    "test:db-fallback": "node test/db-fallback.js",
    "test:db-chunks": "node test/db-chunks.js",
    "test:status-upload": "node test/status-upload.js",
    "test:admin-notify": "node test/admin-notify.js"
  },
  "keywords": [
    "whatsapp-clone",
    "chat",
    "realtime",
    "socket.io",
    "notifications"
  ],
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
